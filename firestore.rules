/**
 * @fileoverview Firestore Security Rules for the MT5 Client Management App.
 *
 * Core Philosophy:
 * This ruleset enforces a strict, document-level access control model. The original client
 * license system and the new Copy Trade system are completely isolated.
 *
.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access control for the original client license documents.
     * @path /clients/{accountNumber}
     */
    match /clients/{accountNumber} {
      allow get, create, update, delete: if isSignedIn();
      allow list: if isSignedIn();
    }
    
    // --- ISOLATED COPY TRADE MODULE RULES ---

    /**
     * @description Manages master account data for the copy trade system.
     * @path /copytrade_masters/{master_id}
     */
    match /copytrade_masters/{master_id} {
        allow read, write: if isSignedIn();
    }
    
    /**
     * @description Manages orders sent by a master account.
     * @path /copytrade_masters/{master_id}/orders/{ticket_master}
     */
    match /copytrade_masters/{master_id}/orders/{ticket_master} {
        allow read, write: if isSignedIn();
    }
    
    /**
     * @description Manages slave account licenses for the copy trade system.
     * @path /copytrade_licenses/{account_login_mt5}
     */
    match /copytrade_licenses/{account_login_mt5} {
      allow read, write: if isSignedIn();
    }

    // Helper function to check if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}

{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-west1"
    },
    "rewrites": [
      {
        "source": "/api/validate",
        "function": "validateClient"
      },
      {
        "source": "**",
        "run": {
          "serviceId": "nextn",
          "region": "us-west1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}